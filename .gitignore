# Local benchmark harnesses.
/bench/
/benchmark/

# Keep readable result tables; exclude raw data, archives, PDFs and tooling.
# README charts remain tracked under assets/benchmarks/.
/benchmarks/*
!/benchmarks/*.md

# Local builds and benchmark executables.
/build/
/bin/
/obj/
*.o
*.obj
*.d
*.dSYM/

# Local tooling and temporary files.
.venv/
.cache/
__pycache__/
*.py[cod]
*.tmp
.DS_Store
