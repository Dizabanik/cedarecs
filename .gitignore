/build/
/bin/
/obj/
/benchmarks/build/
/benchmarks/bin/
/benchmarks/tmp/
*.o
*.obj
*.d
*.dSYM/

# Local tooling and temporary files.
.venv/
.cache/
__pycache__/
*.py[cod]
*.tmp
.DS_Store
