# Benchmark harnesses. Keep published results and README images in Git.
/bench/
/benchmark/

# Benchmark source and plotting tools. Keep the published data and graphics.
/benchmarks/**/*.c
/benchmarks/**/*.cc
/benchmarks/**/*.cpp
/benchmarks/**/*.h
/benchmarks/**/*.hpp
/benchmarks/**/*.py
/benchmarks/**/*.sh

